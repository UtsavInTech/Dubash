# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Load into the shell with: set -a; source .env; set +a

# Upstream dubash
ADMIN_TOKEN=change-me
PUBLIC_URL=
GEMINI_API_KEY=
ASR_URL=
ASR_MODEL=
ASR_API_KEY=
TRANSLATE_URL=
TRANSLATE_MODEL=
TRANSLATE_API_KEY=

# Providers: sarvam, gemini, whisper (ASR_URL) / chat (TRANSLATE_URL).
# Empty: Sarvam when SARVAM_API_KEY is set, else the URL servers, else Gemini.
ASR_PROVIDER=
TRANSLATE_PROVIDER=

# Sarvam (dashboard.sarvam.ai → API Keys): the default for Indian languages.
SARVAM_API_KEY=
SARVAM_ASR_MODEL=        # default saaras:v4 (the only model that takes keyterms)
SARVAM_ASR_MODE=         # benchmark only: codemix… (the server takes asr_mode per room in rooms.yaml)
SARVAM_CHAT_MODEL=       # translation and correction model, default sarvam-105b (per token: ~₹3 per language per hour)
SARVAM_TRANSLATE_MODEL=  # with TRANSLATE_PROVIDER=sarvam-translate (₹20 per 10,000 characters): sarvam-translate:v1 or mayura:v1
SARVAM_TRANSLATE_RPM=    # translate requests per minute for the account: 60 (Starter, default), 200 (Pro), 1000 (Business)
SARVAM_EARLY=            # "on" commits text from partial transcripts: lower latency in long utterances, lower accuracy

# Correction stage: off, rules (Dictation Bank only) or model (bank and
# script with Sarvam's chat model). Default: model with SARVAM_API_KEY.
CORRECTION=
CORRECTION_DEADLINE_MS=  # the model's budget per line, default 800

# Dictation Bank storage: PostgreSQL, or a JSON file in the data directory.
DATABASE_URL=            # e.g. postgres://dubash@localhost:5432/dubash
