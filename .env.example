# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Load into the shell with: set -a; source .env; set +a

# Upstream dubash
ADMIN_TOKEN=change-me
PUBLIC_URL=
GEMINI_API_KEY=
ASR_URL=
ASR_MODEL=
ASR_API_KEY=
TRANSLATE_URL=
TRANSLATE_MODEL=
TRANSLATE_API_KEY=

# Sarvam (dashboard.sarvam.ai → API Keys). Used by cmd/dubash-bench in
# phase 0, and by the server from phase 1.
SARVAM_API_KEY=
SARVAM_ASR_MODEL=        # default saaras:v4 (the only model that takes keyterms)
SARVAM_ASR_MODE=         # optional: codemix keeps English words in Latin script (saaras:v3)
SARVAM_TRANSLATE_MODEL=  # default sarvam-translate:v1; or mayura:v1
